# Marginalia keeper — copy to .env (never commit .env)
# primary: a DEDICATED Alchemy app for this project (its own free 30M CU/mo; ~4 reads/min ≈ 4M CU/mo); fallback: the public node
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/MARGINALIA_APP_KEY
RPC_FALLBACK_URL=https://ethereum-rpc.publicnode.com
# wide-range eth_getLogs (Alchemy free = 10 blocks/call); any public node that serves ~2000-block ranges
LOGS_RPC_URL=https://ethereum-rpc.publicnode.com
# leave empty for DRY mode (simulates and logs only). A fresh key funded with ~0.02 ETH; it holds nothing else.
KEEPER_PRIVATE_KEY=
# token the site presents to POST /venues
KEEPER_API_TOKEN=
# defaults: launch #1283
HOOK_ADDRESS=0xf0457dd0cf526686190e4f057ba19db14d34a0cc
DEPLOY_BLOCK=26169583
LAUNCH_NUMBER=1283
PAYING_WALLET=0xc95f88706ea9649f73b40d3c89b273dc7ebc9d74
POLL_MS=60000
PORT=8790
DB_PATH=./data/keeper.db
# observation schedule in minutes after the horizon (the hook wants >=3 spanning >=1h inside a 6h window)
OBS_SCHEDULE_MIN=5,35,70,300
MAX_FEE_GWEI=30
# hard brake: never more than this many transactions per UTC day
MAX_TX_PER_DAY=60
# the launch fee claim stays OFF until the split is published
CLAIM_FEES=0
FUND_POT_BPS=0
CLAIM_EVERY_DAYS=7
